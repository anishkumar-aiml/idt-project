# Smart Civic Complaint System - Environment Variables Configuration
# Student / Project Owner: Anish Kumar Singh

# Server Port
PORT=3000

# JSON Web Token Secret Key (Change this in production)
JWT_SECRET="smart_civic_super_secure_jwt_token_2026_key"
JWT_EXPIRES_IN="7d"

# MySQL 8 Database Configuration
# When DB_HOST is set, backend establishes an enterprise MySQL 8 pool.
# Leave DB_HOST empty to use the built-in resilient SQLite WASM relational storage.
DB_HOST=""
DB_PORT=3306
DB_USER=""
DB_PASSWORD=""
DB_NAME="smart_civic"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

